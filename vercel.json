
{
  "framework": "vite",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/complete-order?cron=1",
      "schedule": "0 17 * * 0"
    }
  ]
}
